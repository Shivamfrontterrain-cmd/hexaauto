# Telegram API Credentials (get from https://my.telegram.org)
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash

# Google Gemini API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Target Game Bot & Chat
TARGET_BOT=HeXamonbot
# Chat where hunting happens (default is HeXamonbot direct message, or enter a group chat username/id)
HUNT_CHAT=HeXamonbot

# Operating Mode:
# "guess" = dedicated /guess loop for continuous PD farming
# "hunt"  = dedicated /hunt battle & catching loop
# "both"  = run both hunting and guessing concurrently
ACTION_MODE=guess

# Auto-Hunt Automation
AUTO_HUNT_ENABLED=False
HUNT_COMMAND=/hunt
HUNT_INTERVAL=12.0
HUNT_JITTER=3.0
HUNT_INSTA_FLASH=True
HUNT_MIN_DELAY=0.05
HUNT_MAX_DELAY=0.20

# Fast Battle & Catch Automation (lightning-fast turn attacks and throws)
FAST_BATTLE=True
FAST_BATTLE_MIN_DELAY=0.05
FAST_BATTLE_MAX_DELAY=0.20

# Auto-Guess PD Farming (/guess "Who's that Pokémon?")
AUTO_GUESS_ENABLED=True
GUESS_COMMAND=/guess
GUESS_INTERVAL=5.0
GUESS_JITTER=2.0
GUESS_INSTA_FLASH=True
GUESS_MIN_DELAY=0.05
GUESS_MAX_DELAY=0.20

# Auto-Catch Automation
AUTO_CATCH_ENABLED=True
PREFERRED_BALLS=Masterball,Ultraball,Greatball,Repeatball,Regularball,Pokeball

# Hunt Category / Strategy:
# "kill"  = Defeat wild Pokémon with highest damage moves to farm PD & EXP
# "catch" = Catch wild Pokémon with Pokéballs (Repeat Ball for '☆', Ultra/Master for Rares, Regular/Poke for Commons)
HUNT_MODE=kill
BATTLE_SYSTEM=kill
HYBRID_KILL_COMMONS=False

# Emergency Human-in-the-Loop Alert Configuration
# Your personal Telegram User ID (numeric, e.g. 123456789)
ALERT_USER_ID=0
# Optional: Dedicated Telegram Bot Token to send alerts directly to your phone
ALERT_BOT_TOKEN=

# Anti-Detection Reaction Delays (in seconds)
MIN_REACTION_DELAY=2.5
MAX_REACTION_DELAY=5.0
